# Youssef App - Firebase Configuration
# انسخ هذا الملف إلى .env.local وضع بيانات مشروعك من Firebase Console
# المسار: Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ملاحظة: Firebase Storage غير مطلوب نهائياً!
# التطبيق يعمل بنسبة 100% على باقة Firebase المجانية (Spark Plan) بدون بطاقة بنكية
