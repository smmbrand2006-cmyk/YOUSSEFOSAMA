@echo off
chcp 65001 > nul
echo ========================================================
echo       📦 جاري تثبيت حزم ومكتبات المشروع (NPM Install)
echo ========================================================
echo.
cd /d "%~dp0"

echo برجاء الانتظار، جاري تنزيل مكتبات React و Next.js و Firebase...
echo.
call npm install --legacy-peer-deps

if %ERRORLEVEL% equ 0 (
    echo.
    echo ========================================================
    echo  ✅ تم تثبيت جميع الحزم بنجاح!
    echo  ستختفي جميع الخطوط الحمراء من VS Code الآن.
    echo ========================================================
) else (
    echo.
    echo ⚠️ حدث خطأ أثناء التثبيت، تأكد من اتصال الإنترنت وتثبيت Node.js.
)

echo.
pause
